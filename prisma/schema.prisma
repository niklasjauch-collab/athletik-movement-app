// Movura — Prisma schema (Phase 1 scaffold)
//
// This schema follows the data model from the concept document:
// every entity carries a providerId from day one, so the platform
// is multi-tenant / white-label ready even though only one Provider
// (your own business) will be active at first.

generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A tenant on the platform: your own business first, later e.g. Athletik Movement.
/// Branding fields are what make white-labeling possible.
model Provider {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique // used in URLs, e.g. movura.io/p/{slug} before a custom domain is set
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // --- Branding / white-label ---
  appName           String   // shown in UI, PWA manifest, emails
  logoUrl           String?
  primaryColor      String?  @default("#2dd4bf")
  customDomain      String?  @unique // e.g. app.athletikmovement.com
  emailSenderDomain String?  // verified sender domain in Resend/Postmark

  // --- Integrations ---
  calendlyAccountUri String? // Calendly organization/user URI
  stripeAccountId    String? // Stripe Connect account id

  services       Service[]
  clients        Client[]
  digitalProducts DigitalProduct[]
  exercises       Exercise[]
  trainingPlans   TrainingPlan[]
  movementScans   MovementScan[]
  correctivePlans CorrectivePlan[]
  trainingSessions TrainingSession[]
  products        Product[]
}

enum ServiceType {
  SINGLE
  PACKAGE
  DIGITAL
}

/// A bookable or purchasable offering: a single session, a session package, or a digital product.
model Service {
  id                  String      @id @default(cuid())
  providerId          String
  provider            Provider    @relation(fields: [providerId], references: [id])
  name                String
  description         String?
  type                ServiceType
  priceCents          Int
  currency            String      @default("EUR")
  calendlyEventTypeUri String?    // null for DIGITAL services
  packageCredits      Int?        // number of sessions included, only for PACKAGE
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  bookings CreditBalance[]
}

/// A client of a specific Provider (not a platform-wide user — scoped per
/// tenant). Doubles as their login account: the client registers with
/// firstName/lastName/email and sets a password (see Session below); the
/// email is always the username (@@unique per provider, matches how a
/// client only ever belongs to one provider's business in this model).
model Client {
  id               String   @id @default(cuid())
  providerId       String
  provider         Provider @relation(fields: [providerId], references: [id])
  firstName        String
  lastName         String
  email            String
  // Null until the client completes registration's password step, or for
  // clients a coach creates manually without self-service login (e.g.
  // during migration). A null passwordHash means login is not possible —
  // /api/auth/login must check for this rather than comparing against null.
  passwordHash     String?
  stripeCustomerId String?
  createdAt        DateTime @default(now())

  creditBalances CreditBalance[]
  bookings       Booking[]
  orders         Order[]
  trainingPlans  TrainingPlan[]
  movementScans   MovementScan[]
  correctivePlans CorrectivePlan[]
  trainingSessions TrainingSession[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  productAssessments   ProductAssessment[]

  @@unique([providerId, email])
}

/// The credits ledger — tracks remaining sessions per client per package,
/// regardless of whether the package came from a Calendly Meeting Package
/// or from our own legacy/manual entry.
model CreditBalance {
  id               String   @id @default(cuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id])
  serviceId        String
  service          Service  @relation(fields: [serviceId], references: [id])
  creditsRemaining Int
  source           String   // "calendly_meeting_package" | "manual" | "stripe_checkout"
  lowBalanceNotifiedAt DateTime? // set once we've notified provider+client at 0 credits
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum BookingStatus {
  CONFIRMED
  CANCELED
  COMPLETED
}

/// A single booked session, mirrored from a Calendly webhook event.
model Booking {
  id               String        @id @default(cuid())
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id])
  calendlyEventUri String        @unique
  status           BookingStatus @default(CONFIRMED)
  startTime        DateTime
  linkedCreditId   String?       // which CreditBalance this booking consumed, if any
  createdAt        DateTime      @default(now())
}

enum OrderType {
  SINGLE_SESSION
  PACKAGE
  DIGITAL_PRODUCT
}

/// A Stripe purchase — a package top-up or a digital product purchase.
model Order {
  id                    String    @id @default(cuid())
  clientId              String
  client                Client    @relation(fields: [clientId], references: [id])
  type                  OrderType
  stripePaymentIntentId String    @unique
  amountCents           Int
  currency              String    @default("EUR")
  digitalProductId      String?
  digitalProduct        DigitalProduct? @relation(fields: [digitalProductId], references: [id])
  createdAt             DateTime  @default(now())
}

/// A downloadable/assignable training plan.
model DigitalProduct {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
  title       String
  description String?
  fileUrl     String
  priceCents  Int
  currency    String   @default("EUR")
  createdAt   DateTime @default(now())

  orders Order[]

  planExercises TrainingPlanExercise[] // digital plans are also built from Exercise items
}

/// One exercise in the library — the "Baukasten" used to compose training
/// plans (both individual client plans and pre-made digital products).
/// Migrated 1:1 from the legacy BodyControl app (admin.bodycontrol.io);
/// `legacyId` keeps the original Firestore document ID for traceability.
model Exercise {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
  legacyId    String?  @unique // original bodycontrol.io Firestore doc ID, if migrated

  name        String
  nameEn      String? // English exercise name (SmartMotionApproach production spec requires both)
  description String?  @db.Text
  language    String   @default("de") // ISO-ish code, e.g. "de"

  // Whether this exercise is visible in the public/client-facing library.
  // Exercises entered into the app before their video has been filmed
  // (see the SmartMotionApproach "45 fehlende Übungen" production
  // pipeline) are kept isPublished=false — fully specified in the
  // database so planning/production work can proceed, but hidden from
  // /exercises and from the corrective-plan generator's candidate pool
  // until a real video exists. See /exercises/drafts for the internal
  // review view.
  isPublished Boolean @default(true)

  muscleGroups String[] // e.g. ["Beine", "Bauch"]
  equipment    String[] // e.g. ["Theraband"], [] if bodyweight only

  unit        String   // "Sekunden" | "Körpergewicht" (seconds-held vs. rep-based), extend as needed
  pauseSeconds Int     @default(0) // rest between sets
  sets        Int[]    // one entry per set, e.g. [15, 15] reps or [60, 60] seconds
  intensity   String   @default("medium") // "low" | "medium" | "high"
  notes       String?  @db.Text

  // --- Corrective Exercise tagging (NASM/Brookbush, see
  // claude/NASM_CES_Corrective_Strategies_Zusammenfassung.md in the
  // project for the source tables) ---
  // Which phase of the Inhibit -> Lengthen -> Activate -> Integrate
  // continuum this exercise belongs to, if it's usable as a corrective
  // exercise at all. Null/GENERAL = not corrective-tagged (e.g. a plain
  // training exercise from the original BodyControl library).
  correctivePhase CorrectivePhase?
  // Specific muscles this exercise targets, using the same muscle names
  // as the rule-engine reference data (e.g. ["Gastrocnemius", "Soleus"]),
  // NOT the broad muscleGroups above ("Beine"). Used to match exercises
  // to a generated corrective plan's phase/muscle requirements.
  targetMuscles String[]
  // How confident the auto-tagging is; "auto" tags should be spot-checked
  // by the coach, "manual"/"verified" tags are trusted as-is.
  taggingSource String? // "auto" | "manual" | "verified"

  // --- SmartMotionApproach production spec (see
  // claude/SmartMotionApproach_Produktionsplan.md in the project) ---
  // Extended metadata captured for exercises entered via the 15-round
  // production pipeline for the 45 missing exercises. Populated for
  // those; null/empty for exercises migrated straight from BodyControl
  // that predate this spec.
  bibCategory       BibCategory? // BI_ORIGINAL | BI_BASED | SMA_BASED — see rule in README before setting BI_ORIGINAL
  level             ExerciseLevel? // LEVEL_1 (Relax+Stretch) | LEVEL_2 (Activation+Integration) — derivable from correctivePhase but stored for easy filtering
  productionRound   Int? // which of the 15 SmartMotionApproach production rounds this was specified in
  relevantSigns         String[] // Overhead Squat Assessment signs this exercise addresses, e.g. ["Feet Flatten", "Knees Move Inward"]
  relevantSignClusters  String[] // e.g. ["LED", "LPHCD", "UBD", "Asymmetrical Weight Shift"]
  relevantSubsystems    String[] // e.g. ["ISS", "POS", "AOS", "DLS"]
  rationale         String? @db.Text // why this exercise is needed in the library
  startPosition     String? @db.Text // Ausgangsposition
  execution         String? @db.Text // exact step-by-step execution
  coachingCues      String[] // 3-5 most important coaching cues
  commonMistakes    String[]
  dosageNote        String? @db.Text // human-readable dosage beyond the structured sets/unit/pauseSeconds fields
  regressionNote    String? @db.Text
  progressionNote   String? @db.Text
  contraindicationNote String? @db.Text // when this exercise is NOT appropriate

  // Which already-published exercise this is functionally similar to,
  // and what the difference is — required by the production spec so
  // coaches understand why a seemingly-similar exercise was added.
  similarExistingExerciseId String?
  similarExistingExercise   Exercise?  @relation("SimilarExercise", fields: [similarExistingExerciseId], references: [id])
  similarToThis             Exercise[] @relation("SimilarExercise")
  similarExistingDifference String? @db.Text

  // Storage paths (not full signed URLs — those are generated on demand).
  // These mirror the legacy Firebase Storage path structure
  // (media/exercises/{legacyId}/{male|female}/video/{file}) until the
  // actual video files are re-uploaded into Movura's own storage.
  videoMalePath   String?
  videoFemalePath String?
  // Once videos are migrated to Movura's own storage (see migration notes
  // in README), these get populated with real playback URLs and the
  // *Path fields above become historical/reference only.
  videoMaleUrl    String?
  videoFemaleUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planItems TrainingPlanExercise[]
  correctivePlanItems CorrectivePlanItem[]
  programSessionItems ProgramSessionExercise[]

  // The SmartMotion Master-Spec's "verbindliche" exercise registry ID
  // (E001-E116, see SmartMotion_App_22_Programme_Claude_MasterSpec.md
  // section 8 and prisma/seed-data/smartmotion-exercise-registry.json).
  // Null for exercises outside that registry (e.g. the generic
  // corrective-exercises.json templates not referenced by any of the 22
  // sellable programs). This is what lets ProgramSessionExercise rows be
  // seeded by looking up "E0xx" rather than duplicating exercise content
  // per program (spec requirement: "Exercise-Referenzen nur per
  // exercise_id; Exercise-Content nicht in Programme kopieren").
  smartMotionCode String? @unique

  @@index([providerId])
}

enum TrainingPlanKind {
  INDIVIDUAL // built for one specific client
  SELLABLE   // pre-made digital product, sold via DigitalProduct
}

/// A training plan: an ordered composition of exercises. Used both for
/// plans built for an individual client and as the basis of a sellable
/// digital product (see concept doc section 3.3).
model TrainingPlan {
  id         String           @id @default(cuid())
  providerId String
  provider   Provider         @relation(fields: [providerId], references: [id])
  kind       TrainingPlanKind
  title      String
  clientId   String? // set when kind = INDIVIDUAL
  client     Client?          @relation(fields: [clientId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  items TrainingPlanExercise[]
  trainingSessions TrainingSession[]
}

/// One exercise slot within a training plan, with its own order/overrides.
model TrainingPlanExercise {
  id             String   @id @default(cuid())
  trainingPlanId String
  trainingPlan   TrainingPlan @relation(fields: [trainingPlanId], references: [id])
  exerciseId     String
  exercise       Exercise @relation(fields: [exerciseId], references: [id])
  order          Int
  setsOverride   Int[]    // if empty, use Exercise.sets as default
  notes          String?

  // A sellable digital product can reuse the same plan-item shape when its
  // content is generated from a TrainingPlan (kind = SELLABLE) rather than
  // hand-authored — link is optional and only used in that case.
  digitalProductId String?
  digitalProduct    DigitalProduct? @relation(fields: [digitalProductId], references: [id])

  @@unique([trainingPlanId, order])
}

// ============================================================
// SmartMotionScan upload + automatic Corrective Exercise plans
// (NASM Corrective Exercise Continuum / Brookbush SmartMotionApproach)
// See claude/NASM_CES_Corrective_Strategies_Zusammenfassung.md and
// Brookbush_Institute_Zusammenfassung.md in the project for the source
// tables the rule engine (src/lib/corrective/) is built from.
// ============================================================

enum CorrectivePhase {
  INHIBIT   // SMR / foam rolling / release ("MoveFlexRelax")
  LENGTHEN  // static / neuromuscular stretching ("MoveFlexStretch")
  ACTIVATE  // isolated strengthening / positional isometrics ("MoveSyncActivation")
  INTEGRATE // multi-planar / functional movement ("MoveSyncIntegration")
}

/// How an exercise's technique/target relates to Brookbush Institute
/// source material. NEVER set BI_ORIGINAL unless the concrete variant has
/// actually been verified against a Brookbush course/article — see the
/// production spec's quality rule in the project doc.
enum BibCategory {
  BI_ORIGINAL // the concrete exercise/technique exists at Brookbush as-is
  BI_BASED    // target muscle/function/progression logic is from Brookbush; the concrete variant is adapted for SmartMotionApproach
  SMA_BASED   // a SmartMotionApproach-original functional extension built on Brookbush logic, not a Brookbush exercise itself
}

enum ExerciseLevel {
  LEVEL_1 // MoveFlexRelax + MoveFlexStretch (Inhibit/Lengthen)
  LEVEL_2 // MoveSyncActivation + MoveSyncIntegration (Activate/Integrate)
}

enum ScanStatus {
  UPLOADED       // file received, not yet reviewed
  FINDINGS_ENTERED // coach has recorded the OHSA-style compensations found
  PLAN_GENERATED // a CorrectivePlan has been generated from the findings
}

/// An uploaded SmartMotionScan result (or any other movement-assessment
/// report) for a client. The file itself is stored wherever Movura's media
/// storage lives (see .env.example) — this row just tracks metadata and
/// review status. We deliberately do NOT try to auto-parse the report
/// (SmartMotionScan runs on a third-party platform — Moti Physio 2 — whose
/// export format isn't something we can reliably parse without a sample);
/// instead the coach reviews the report and records findings via
/// MovementFinding, which is what actually drives plan generation. This
/// mirrors how NASM/Brookbush teach the assessment-to-program workflow
/// anyway: record findings, then look up the corrective strategy.
model MovementScan {
  id         String     @id @default(cuid())
  providerId String
  provider   Provider   @relation(fields: [providerId], references: [id])
  clientId   String
  client     Client     @relation(fields: [clientId], references: [id])

  fileUrl     String // wherever the uploaded report was stored
  fileName    String
  contentType String?
  status      ScanStatus @default(UPLOADED)
  notes       String?    @db.Text

  uploadedAt DateTime @default(now())

  findings MovementFinding[]
  plans    CorrectivePlan[]
}

/// The standard OHSA-style compensations (NASM ch.6 / Brookbush OHSA
/// Part 1+2). Keys match src/lib/corrective/rules.ts — that file is the
/// single source of truth for which muscles/exercises each compensation
/// maps to; this enum just constrains what can be recorded.
enum Compensation {
  FEET_TURN_OUT
  FEET_FLATTEN
  KNEES_MOVE_INWARD
  KNEES_MOVE_OUTWARD
  EXCESSIVE_FORWARD_LEAN
  LOW_BACK_ARCHES
  LOW_BACK_ROUNDS
  ARMS_FALL_FORWARD
  SHOULDER_ELEVATION
  SCAPULAR_WINGING
  FORWARD_HEAD
  ASYMMETRIC_SHIFT_CERVICAL
  ASYMMETRIC_WEIGHT_SHIFT
  HEELS_RISE
}

enum Side {
  LEFT
  RIGHT
  BILATERAL
}

/// How clinically severe a finding appears in the source report, when
/// that's available (e.g. the SmartMotionScan device's own MILD/MÄSSIG/
/// SCHWER dysbalance rating). Optional — coach-entered findings via the
/// /scans checklist don't set this; AI-extracted findings from
/// analyzeScan.ts do when the report states it. Used by
/// splitIntoSessions.ts to decide which findings go in the
/// priority (Plan A) vs. supplementary (Plan B) session when a scan
/// produces more compensations than fit one sensible session.
enum Severity {
  MILD
  MODERATE
  SEVERE
}

/// One compensation the coach identified while reviewing a MovementScan
/// report. Side matters for asymmetric compensations (see the rule
/// engine's "same side / opposite side" muscle lists for e.g. Asymmetric
/// Weight Shift) — use BILATERAL when the report doesn't distinguish.
model MovementFinding {
  id             String       @id @default(cuid())
  movementScanId String
  movementScan   MovementScan @relation(fields: [movementScanId], references: [id])
  compensation   Compensation
  side           Side         @default(BILATERAL)
  severity       Severity?
  createdAt      DateTime     @default(now())

  @@unique([movementScanId, compensation, side])
}

/// A Corrective Exercise plan auto-generated from a MovementScan's
/// findings by src/lib/corrective/generatePlan.ts. Distinct from
/// TrainingPlan (which is for general/sellable training content) because
/// it's system-generated, always INDIVIDUAL, and always tied back to the
/// scan that produced it for traceability/re-generation.
///
/// A single scan normally produces ONE plan. When there are enough
/// findings that one session would be overloaded, splitIntoSessions.ts
/// produces TWO complete plans instead (each its own full Inhibit->
/// Integrate session) — priorityRank/label distinguish them ("Plan A —
/// Schwerpunkt" for the higher-severity findings, "Plan B — Ergänzend"
/// for the rest), so a client alternates between them across the week
/// rather than getting one overwhelming list.
model CorrectivePlan {
  id             String       @id @default(cuid())
  providerId     String
  provider       Provider     @relation(fields: [providerId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  movementScanId String
  movementScan   MovementScan @relation(fields: [movementScanId], references: [id])

  label        String? // e.g. "Plan A — Schwerpunkt", null when there's only one plan for the scan
  priorityRank Int? // 1 = higher-priority/more severe findings, 2 = supplementary; null when there's only one plan

  generatedAt DateTime @default(now())

  items CorrectivePlanItem[]
  trainingSessions TrainingSession[]
}

/// One exercise slot in a CorrectivePlan, tagged with which phase it
/// belongs to and (for traceability) which finding(s) drove its selection.
model CorrectivePlanItem {
  id               String          @id @default(cuid())
  correctivePlanId String
  correctivePlan   CorrectivePlan  @relation(fields: [correctivePlanId], references: [id])
  exerciseId       String
  exercise         Exercise        @relation(fields: [exerciseId], references: [id])
  phase            CorrectivePhase
  order            Int
  targetMuscle     String // which muscle from the exercise's targetMuscles justified picking it here
  sourceCompensations Compensation[] // which finding(s) this exercise addresses
  // Which side this exercise slot is actually needed for, derived by
  // src/lib/corrective/generatePlan.ts from the side(s) recorded on the
  // MovementFinding(s) that drove it: LEFT/RIGHT only when every
  // contributing finding was unilateral on that same side, BILATERAL
  // otherwise (including when findings conflict or the compensation
  // wasn't recorded per side). Drives the side-aware instruction text
  // rendered by src/lib/corrective/sideInstructions.ts — the shared
  // Exercise.description/execution text is never rewritten per client;
  // instead the plan display composes a client-specific instruction from
  // this field at render time.
  side             Side            @default(BILATERAL)

  sessionLogs TrainingSessionExercise[]

  @@unique([correctivePlanId, phase, order])
}

// ============================================================
// Training & progress documentation, pre/post-training questionnaires
// ============================================================
//
// Phase 1 note: the /training and /progress pages currently persist this
// data client-side (localStorage, see src/lib/trainingLog.ts) rather than
// through Prisma, for the same reason the rest of this scaffold does
// (no DATABASE_URL connected yet — see README). The models below are the
// target shape those pages/API routes should write to once the database
// is connected; the localStorage records use the same field names so the
// migration is a straight copy.

enum SessionStatus {
  PLANNED
  COMPLETED
  SKIPPED
}

enum QuestionnaireType {
  PRE
  POST
}

/// One actual (or planned) training session for a client, optionally tied
/// back to the CorrectivePlan or TrainingPlan it was built from, so
/// progress can be tracked against the plan that was prescribed.
model TrainingSession {
  id               String   @id @default(cuid())
  providerId       String
  provider         Provider @relation(fields: [providerId], references: [id])
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id])

  correctivePlanId String?
  correctivePlan   CorrectivePlan? @relation(fields: [correctivePlanId], references: [id])
  trainingPlanId   String?
  trainingPlan     TrainingPlan?   @relation(fields: [trainingPlanId], references: [id])

  scheduledFor DateTime?
  completedAt  DateTime?
  status       SessionStatus @default(PLANNED)
  notes        String?       @db.Text

  exerciseLogs   TrainingSessionExercise[]
  questionnaires SessionQuestionnaire[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One exercise as actually performed within a TrainingSession — what was
/// prescribed (via correctivePlanItemId, when applicable) vs. what
/// actually happened, including which side was trained (should normally
/// match CorrectivePlanItem.side, but is recorded independently since a
/// client's actual capability on the day can differ from the plan).
model TrainingSessionExercise {
  id                String   @id @default(cuid())
  trainingSessionId String
  trainingSession    TrainingSession @relation(fields: [trainingSessionId], references: [id])
  exerciseId         String
  exercise           Exercise @relation(fields: [exerciseId], references: [id])
  correctivePlanItemId String?
  correctivePlanItem   CorrectivePlanItem? @relation(fields: [correctivePlanItemId], references: [id])

  order              Int
  side               Side     @default(BILATERAL)
  completed          Boolean  @default(false)
  setsCompleted      Int[]    // actual reps/seconds achieved per set, one entry per set
  painDuringExercise Int?     // 0-10 (NPRS)
  notes              String?  @db.Text

  @@unique([trainingSessionId, order])
}

/// A pre- or post-training questionnaire response for one session. Fields
/// are grouped by which `type` they apply to (see comments) — a single
/// flexible model rather than two, since a session has at most one of
/// each type and the fields don't overlap.
model SessionQuestionnaire {
  id                 String            @id @default(cuid())
  trainingSessionId String
  trainingSession    TrainingSession   @relation(fields: [trainingSessionId], references: [id])
  type               QuestionnaireType

  // --- type = PRE ("wie geht es dir heute, vor dem Training?") ---
  painLevel      Int?    // 0-10, general pain today (NPRS)
  painLocation   String?
  energyLevel    Int?    // 0-10
  sleepQuality   Int?    // 0-10
  stressLevel    Int?    // 0-10
  readyToTrain   Boolean?

  // --- type = POST ("wie war das Training?") ---
  rpe               Int?     // 0-10 Borg RPE / subjektive Anstrengung
  painDuringSession Int?     // 0-10
  painAfterSession  Int?     // 0-10
  difficultyRating  Int?     // 0-10, zu leicht (0) .. zu schwer (10)
  satisfaction      Int?     // 0-10
  wouldRepeat       Boolean?

  notes       String?  @db.Text
  submittedAt DateTime @default(now())

  @@unique([trainingSessionId, type])
}

// ============================================================
// Client authentication (registration / login / password reset)
// ============================================================
//
// Email is always the username (Client.email, unique per provider — see
// the Client model comment). Passwords are hashed with bcrypt
// (src/lib/auth.ts) before ever reaching the database. Sessions are
// server-side and revocable (not a stateless JWT): the plaintext token
// lives only in the client's httpOnly cookie, and only its SHA-256 hash
// is stored here, so a stolen database dump can't be replayed as a valid
// session — same reasoning as the password hash itself.

/// A logged-in session for a Client. The httpOnly cookie holds the
/// plaintext token; only its hash is ever persisted, so leaking this
/// table doesn't let anyone forge a session. Deleting the row (on
/// logout, or by an admin) immediately invalidates the session — unlike
/// a stateless JWT, which would keep validating until it expires.
model Session {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([clientId])
}

/// A "Passwort vergessen" reset request. Same hash-only-at-rest pattern
/// as Session: the emailed link carries the plaintext token, only its
/// hash is stored. `usedAt` prevents a link being replayed after it's
/// been used once; expired/used tokens are rejected by
/// /api/auth/reset-password regardless of whether they're still present
/// in the table (cleanup is a nice-to-have, not a correctness
/// requirement).
model PasswordResetToken {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
}

// ============================================================
// SmartMotion-Programme: 22 verkaufbare 12-Wochen-Programme
// ============================================================
//
// Source of truth for this section's structure/content is
// SmartMotion_App_22_Programme_Claude_MasterSpec.md (kept at the repo
// root), specifically its section 10 "Claude – technische
// Umsetzungsanforderungen". Distinct from CorrectivePlan (which is
// auto-generated per-client from a MovementScan's findings): a Product
// here is a pre-authored, sellable 12-week program a client purchases
// and follows on a fixed schedule, not something generated from their
// own assessment data.
//
// Seeded from prisma/seed-data/smartmotion-products-catalog.json (all 22,
// catalog fields only) and prisma/seed-data/smartmotion-programs.json
// (full week-by-week session structure, LAUNCH PRODUCTS ONLY for now --
// see README "SmartMotion-Programme" for why the other 12 exist as
// Product rows with isPublished=false but no ProgramBlock rows yet).

enum ProductCategory {
  HALTUNG                        // "Haltung" bundle (P01-P04)
  BESCHWERDEN_RETURN_TO_MOVEMENT // "Beschwerden & Return to Movement" (P05-P22)
}

/// One sellable 12-week SmartMotion program (e.g. "P01 – Stabile
/// Beinachse"). Catalog/marketing fields live here; the actual week-by-
/// week content lives in ProgramBlock/ProgramSession/ProgramSessionExercise
/// below, kept separate per the spec's "Exercise-Content nicht in
/// Programme kopieren" rule (exercises are referenced, never duplicated).
model Product {
  id         String          @id @default(cuid())
  providerId String
  provider   Provider        @relation(fields: [providerId], references: [id])

  // The spec's own product ID (e.g. "P01") -- kept alongside the cuid
  // `id` purely for traceability back to the master spec document; not
  // used as a foreign key anywhere.
  specId     String          @unique
  slug       String
  category   ProductCategory
  title      String

  // --- Verkaufspsychologische Kurzbeschreibung (verbatim from the spec,
  // never paraphrased -- this is reviewed marketing copy) ---
  hook        String @db.Text
  description String @db.Text
  forYou      String @db.Text // "Für dich, wenn:"
  cta         String

  priceCents Int    // parsed from the spec's "Preis" field, e.g. 7900 for "79 €"
  priceNote  String? @db.Text // full raw price text when there's more than a flat price, e.g. "79 € / 90 Tage (69 € optionaler Launch-Test)"
  accessDays Int    @default(90)

  isPublished   Boolean @default(false) // true only for the 10 launch products (spec section 6); the other 12 exist fully cataloged but hidden
  contentStatus String  // free-text status tag from the spec, e.g. "ready-with-side-selection", "blocked-missing-forearm-loading"
  frequency     String  // e.g. "4–5 Einheiten/Woche, ca. 15–25 Minuten"

  testRetestProtocol String  @db.Text // what to measure identically in week 0/4/8/12 (spec section 4)
  specialLogicNote    String? @db.Text // product-specific safety/gating note beyond the global check (spec section 2), e.g. P08's stress-fracture caveat
  abschluss           String? @db.Text // week-12 close-out copy, when specified

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks      ProgramBlock[]
  assessments ProductAssessment[]

  @@unique([providerId, slug])
}

/// One 4-week block of a Product's 12-week program (weeks 1-4, 5-8, or
/// 9-12 -- see spec section 3 "Globale Dosierung"). Holds the block-level
/// progression rule; the actual exercises live on its two ProgramSessions
/// (A/B, alternated across the block per spec section 3's "Session-Logik").
model ProgramBlock {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  weekStart Int // 1, 5, or 9
  weekEnd   Int // 4, 8, or 12

  progressionRule String @db.Text // "Progressionskriterium zu Woche N"

  sessions ProgramSession[]

  @@unique([productId, weekStart])
}

/// Session "A" or "B" within a ProgramBlock -- clients alternate between
/// the two across the 4-week block. Each session independently spans all
/// four SmartMotion phases (spec rule #2: "Jede aktive Trainingseinheit
/// enthält grundsätzlich alle vier Phasen").
model ProgramSession {
  id             String       @id @default(cuid())
  programBlockId String
  programBlock   ProgramBlock @relation(fields: [programBlockId], references: [id])

  label String // "A" | "B"

  items ProgramSessionExercise[]

  @@unique([programBlockId, label])
}

/// One exercise slot within a ProgramSession. References Exercise by ID
/// only (per spec requirement #3) -- never copies exercise content.
model ProgramSessionExercise {
  id               String          @id @default(cuid())
  programSessionId String
  programSession   ProgramSession  @relation(fields: [programSessionId], references: [id])
  exerciseId       String
  exercise         Exercise        @relation(fields: [exerciseId], references: [id])
  phase            CorrectivePhase // reuses the Inhibit/Lengthen/Activate/Integrate enum (== MoveFlexRelax/MoveFlexStretch/MoveSyncActivation/MoveSyncIntegration, see that enum's doc comment)
  order            Int             // position within this session+phase

  @@unique([programSessionId, phase, order])
}

enum AssessmentStatus {
  PROGRESS       // fortschritt -- ready for the next block
  STAY           // stay -- repeat the current block
  REGRESS        // regress -- step back a level
  MEDICAL_REVIEW // flagged for professional follow-up, not a self-service decision
}

/// One Test/Re-Test checkpoint for a client's Product (spec section 4),
/// taken at week 0/4/8/12 under identical conditions. `testValues` is
/// deliberately Json: each product's test protocol is different (e.g.
/// P01's Overhead Squat 0/1/2 scores vs. P09's Sit-to-Stand rep count),
/// so a fixed relational shape would mean a wide, mostly-null table --
/// Json keeps each product's own test fields self-describing. This is
/// explicitly NOT a diagnosis (spec rule #5) -- `status` drives
/// progress/stay/regress copy, never a clinical claim.
model ProductAssessment {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  assessmentWeek Int // 0, 4, 8, or 12
  performedAt    DateTime @default(now())

  // 0-10 scales from spec section 4 -- null when the product doesn't
  // address symptoms (e.g. the pure "Haltung" programs) or the client
  // skipped an optional field.
  avgSymptomIntensity      Int?
  targetActivityConfidence Int?

  testValues Json    // programmspezifische Testwerte, shape defined per-product in the spec's "Test & Re-Test" section
  mediaUrl   String? // optional photo/video, same camera position as prior assessments

  status AssessmentStatus

  @@index([clientId, productId])
}
