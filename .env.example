# Database (Phase 1+) — e.g. a Supabase or Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/movura"

# Calendly (Phase 1+)
# API key + org URI: https://developer.calendly.com/getting-started
CALENDLY_API_KEY=""
CALENDLY_ORGANIZATION_URI=""
# Signing key for verifying incoming webhooks (Phase 2, see TODO in
# src/app/api/webhooks/calendly/route.ts)
CALENDLY_WEBHOOK_SIGNING_KEY=""

# Stripe (Phase 1+)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Used to verify webhook signatures (Phase 1, see TODO in
# src/app/api/webhooks/stripe/route.ts)
STRIPE_WEBHOOK_SECRET=""

# Email (Phase 3) — Resend or Postmark, used for booking confirmations,
# reminders and low-balance notifications
RESEND_API_KEY=""
EMAIL_FROM="Movura <hello@movura.io>"

# Auth (Phase 3) — client portal login, e.g. Supabase Auth or Clerk
# AUTH_SECRET=""

# Anthropic API (Phase 1+, optional) — powers the "PDF automatisch
# analysieren" button on /scans (src/lib/corrective/analyzeScan.ts), which
# reads an uploaded SmartMotionScan report and proposes OHSA findings for
# the coach to review before generating a plan. Leave unset to disable the
# button; findings can always be entered manually instead.
# Get a key at https://console.anthropic.com — check
# https://docs.claude.com/en/docs/about-claude/models for the current
# recommended model name before setting ANTHROPIC_MODEL.
#
# IMPORTANT: enabling this sends client health data (the scan report) to
# Anthropic's API. Before using it in production, make sure that's covered
# by an Auftragsverarbeitungsvertrag (AVV/DPA) with Anthropic and by the
# client's informed consent — see the concept doc's DSGVO/Gesundheitsdaten
# section and README "Training- & Fortschrittsdokumentation".
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
